// ============================================================
//  สาธิตฟิสิกส์: ลูกบอลตกจากที่สูงแล้วเด้งกลับ (Falling & Bouncing Ball)
//  เขียนด้วย Processing (Java mode)
//  แปลงมาจากเวอร์ชัน Processing python-mode (ball_bounce_p5py.py)
// ============================================================

// ---------- ค่าตั้งต้นของลูกบอล (ตัวแปรสถานะ) ----------
float diameter = 40;           // เส้นผ่านศูนย์กลางลูกบอล (พิกเซล)
float x = 200;                 // ตำแหน่งแนวนอน (คงที่ ไม่ขยับ)
final float INITIAL_Y = 20;    // ตำแหน่งแนวตั้ง "เริ่มต้น" เก็บไว้ใช้ตอนรีสตาร์ท
float y = INITIAL_Y;           // ตำแหน่งแนวตั้งปัจจุบัน (จุดที่ปล่อยลูกบอล)
float vy = 0;                  // ความเร็วในแนวดิ่ง (pixel/frame) เริ่มต้น = หยุดนิ่ง

// ---------- ค่าคงที่ทางฟิสิกส์ ----------
float gravity = 0.6;           // ความเร่งเนื่องจากแรงโน้มถ่วง (ยิ่งมาก ยิ่งตกไว)
float restitution = 0.75;      // สัมประสิทธิ์การเด้งกลับ (0-1)
                               //   1.0 = เด้งกลับสูงเท่าเดิมตลอด (ไม่มีจริง)
                               //   0.0 = ตกถึงพื้นแล้วหยุดทันที ไม่เด้ง
                               //   ค่ายิ่งน้อย พลังงานยิ่งหายไปเร็ว ลูกบอลจะเด้งเตี้ยลงเรื่อยๆ


void setup() {
  size(400, 400);
}


void draw() {
  background(230);

  // ----- ขั้นที่ 1: ปรับความเร็วตามแรงโน้มถ่วง (v = v + g) -----
  vy = vy + gravity;

  // ----- ขั้นที่ 2: ปรับตำแหน่งตามความเร็ว (y = y + v) -----
  y = y + vy;

  // ----- ขั้นที่ 3: ตรวจสอบว่าลูกบอลชนพื้นหรือยัง -----
  float floorY = height - diameter / 2;   // ตำแหน่งพื้น (นับที่จุดศูนย์กลางลูกบอล)

  if (y > floorY) {
    y = floorY;                  // ดันลูกบอลกลับมาแตะพื้นพอดี (กันจมพื้น)
    vy = vy * -restitution;      // กลับทิศทางความเร็ว และลดขนาดลง (สูญเสียพลังงาน)

    // ถ้าความเร็วเด้งกลับน้อยมากแล้ว ให้ถือว่าลูกบอลหยุดสนิท
    // (ป้องกันการสั่นค้างไปเรื่อยๆ แบบไม่มีที่สิ้นสุด)
    if (abs(vy) < 1) {
      vy = 0;
    }
  }

  // ----- วาดพื้น -----
  fill(90);
  noStroke();
  rect(0, height - 8, width, 8);

  // ----- วาดลูกบอล -----
  fill(0, 0, 255);
  ellipse(x, y, diameter, diameter);
}


// ============================================================
//  รีสตาร์ทการจำลอง: กดเมาส์ หรือ กดปุ่มใดก็ได้บนคีย์บอร์ด
// ============================================================
void resetBall() {
  y = INITIAL_Y;   // ดึงลูกบอลกลับไปจุดเริ่มต้นด้านบน
  vy = 0;          // ความเร็วกลับเป็นศูนย์ (เริ่มตกใหม่)
}


void mousePressed() {
  resetBall();
}


void keyPressed() {
  resetBall();
}
